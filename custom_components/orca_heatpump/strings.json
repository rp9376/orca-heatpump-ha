{
  "config": {
    "step": {
      "user": {
        "title": "Connect to the Orca heat pump",
        "description": "Enter the address and login of the heat pump's touch display. Give the display a fixed IP address on your network.",
        "data": {
          "host": "Host",
          "username": "Username",
          "password": "Password",
          "allow_power_limits": "Allow changing power limits"
        },
        "data_description": {
          "host": "IP address or host name of the touch display.",
          "username": "Username of the display's web interface (usually admin).",
          "password": "Password of the display's web interface.",
          "allow_power_limits": "Risky: makes the heat pump's power limits for heating, hot water, cooling and quiet mode adjustable. Wrong values can stop the heat pump; values outside the manufacturer's range are always refused."
        }
      },
      "old_integration": {
        "title": "Orca Energy integration found",
        "description": "The older Orca Energy integration (orca-energy-ha) is set up for {host}. The display allows only a few logins, so two integrations polling it lock each other and the Moja Orca app out. Remove or disable the Orca Energy integration first; you can continue anyway."
      },
      "reauth_confirm": {
        "title": "Log in again",
